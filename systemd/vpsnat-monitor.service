[Unit]
Description=VPSNAT resource and bandwidth monitor (node)
After=network-online.target snap.lxd.daemon.service vpsnat-expire.timer
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vpsnat monitor-loop
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
