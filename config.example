# VPSNAT runtime configuration lives in /etc/vpsnat/vpsnat.conf
# Values below are optional. 0 means unlimited where documented.
PUBLIC_IP=
GRACE_DAYS=3
SHARED_SUSPEND_MINUTES=60
SHARED_RESOURCE_THRESHOLD=100
RESOURCE_SAMPLE_SECONDS=15
BANDWIDTH_DEFAULT_QUOTA_GB=0
BANDWIDTH_DEFAULT_RATE_MBIT=0
NETWORK_MODE=direct
RELAY_WG_PORT=51820
# Telegram bot (set by: vpsnat bot-setup)
TG_TOKEN=
TG_ADMIN=
# Web panel (set by: vpsnat web-setup)
WEB_PORT=8787
WEB_BIND=0.0.0.0
WEB_ADMIN_USER=admin
WEB_ADMIN_HASH=
WEB_API_KEY=
# 1 jika di belakang reverse proxy/tunnel TLS (baca IP klien dari X-Forwarded-For & tandai cookie Secure)
WEB_TRUST_PROXY=0
WEB_SESSION_HOURS=12
# Domain + HTTPS (diatur oleh: vpsnat web-domain)
WEB_DOMAIN=
# header IP klien saat WEB_TRUST_PROXY=1: X-Forwarded-For (nginx) atau CF-Connecting-IP (Cloudflare Tunnel)
WEB_IP_HEADER=X-Forwarded-For
# Tampilan
WEB_BRAND=VPSNAT
WEB_LOGO_URL=
